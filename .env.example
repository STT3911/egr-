# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=egr_db
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/3

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/4
CELERY_RESULT_BACKEND=redis://redis:6379/5

# EGR API URLs
EGR_API_URL=http://egr.gov.by/api/v2/egr
EGR_MOBILE_API_URL=https://egr.gov.by/egrmobile/api/v1

# Application Configuration
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Security
API_KEY=your_secret_api_key_here_minimum_32_chars
ALLOWED_API_KEYS=key1,key2,key3

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://test.tendex.by,https://test.tendex.by

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
